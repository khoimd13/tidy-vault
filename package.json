{
  "name": "vault-tidy",
  "version": "0.5.0",
  "private": true,
  "description": "Suggestion-only cleanup assistant for Google Photos with on-device AI (Chrome extension).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky",
    "preview:ui": "vite --config preview/vite.config.ts",
    "assets": "node scripts/prepare-assets.mjs",
    "model:fetch": "node scripts/prepare-assets.mjs --model",
    "predev": "npm run -s assets",
    "prebuild": "npm run -s assets",
    "test:model": "vitest run --config vitest.model.config.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml}": "prettier --write"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "idb": "^8.0.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
