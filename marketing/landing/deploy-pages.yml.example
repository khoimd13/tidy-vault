# Template: copy to .github/workflows/deploy-pages.yml to publish marketing/landing/ on
# GitHub Pages (https://khoimd13.github.io/tidy-vault/). Then in the repo: Settings → Pages →
# Source: "GitHub Actions". Replace STORE_URL in index.html and add og-image.png first.
name: Deploy landing page

on:
  push:
    branches: [main]
    paths: ['marketing/landing/**']
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: marketing/landing
      - id: deployment
        uses: actions/deploy-pages@v4
